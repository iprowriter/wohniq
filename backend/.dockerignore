# Keep the Docker build context small and free of secrets.
.venv/
__pycache__/
**/__pycache__/
.pytest_cache/
.ruff_cache/
.env
.env.*

# Lifestyle Match raw source files (~250 MB; only `make lifestyle-data` reads them —
# the API ships the generated data/lifestyle/regions.json + regions_geo.json).
data/lifestyle/raw/*
!data/lifestyle/raw/README.md

# Local eval outputs
evals/results/

# Berlin Neighbourhoods raw source files (~160 MB; only `make neighborhoods-data` reads
# them — the API ships the generated data/neighborhoods/neighborhoods.json).
data/neighborhoods/raw/*
!data/neighborhoods/raw/README.md

# Berlin open-data build (live mode reads Supabase; ADR-0016)
data/berlin/build/
