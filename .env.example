# Copy to `.env` and fill in. NEVER commit the real .env (see .gitignore).
# .env is read by backend/core/config.py via pydantic-settings.

# Runtime
ENVIRONMENT=dev

# Offline demo mode: serve bundled fixtures (backend/data/demo/) with no database or
# external API calls. Accepts 1/0 (also true/false, yes/no, on/off); other values
# stop the backend at startup. Precedence, first match wins:
#   WOHNIQ_DEMO=1        -> demo, even if DATABASE_URL is set (the URL is ignored)
#   DATABASE_URL empty   -> demo (0 can't force live mode without a database)
#   otherwise            -> live
WOHNIQ_DEMO=0

# "Right now" live departures (transport.rest, keyless). The only network call demo mode
# may make; 0 = fully offline (the nearest-stops list still shows). Default 1.
WOHNIQ_LIVE_DEPARTURES=1

# --- Gemini (LLM + embeddings) ---
# Free-tier key from Google AI Studio. Used for parser/scam_text/explain + embeddings.
GEMINI_API_KEY=
# Chat model id. Google retires ids and new keys may not get old ones; change it here
# (or on Railway) without touching code. Default gemini-2.5-flash.
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# Thinking tokens per call: 0 = off (faster for these short tasks), -1 = model default.
# GEMINI_THINKING_BUDGET=0

# --- Fast search (ADR-0022): seconds before the deterministic path answers ---
# SEARCH_PARSE_TIMEOUT_S=4
# SEARCH_EXPLAIN_TIMEOUT_S=25
# SEARCH_ENRICH_TIMEOUT_S=2.5

# --- Supabase (Postgres + pgvector + storage) ---
# Connection string for migrations/queries, plus REST creds if using the supabase client.
# Use the transaction pooler (port 6543): the session pooler (5432) allows only 15 clients
# in total and parallel lookups run out of them (ADR-0022).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Pexels (image seeding) ---
# Free API key from pexels.com/api. Used once by the image seeder.
PEXELS_API_KEY=

# --- Berlin open data (`make berlin-data`, ADR-0016) ---
# Folder with Berlin Visualized's raw files (its data/raw). Default: ../berlinvisualized/data/raw
# next to this repo. Only read at build time; nothing from it is committed.
BERLIN_RAW_DIR=

# Note: BVG/VBB transit API, OSM Overpass, and Nominatim are keyless (no secrets needed).

# --- Frontend (Next.js reads NEXT_PUBLIC_* at build time) ---
# Base map. Default: <API>/tiles/berlin.pmtiles (local file from `make berlin-data`, offline).
# For a deployment (set on Vercel, not here): the Protomaps API, same look, all of Germany
# (ADR-0021): https://api.protomaps.com/tiles/v4/{z}/{x}/{y}.mvt?key=<key>
# or a hosted PMTiles copy, e.g. the zoom-14 one from `make map-web` in Supabase Storage.
# NEXT_PUBLIC_MAP_TILES_URL=
